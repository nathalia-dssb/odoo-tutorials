<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_property_offers_document">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="property.name" />
                        </h2>
                        <div>
                            <strong>
                                <t t-esc="_t('Salesperson:')" />
                            </strong>
                            <span t-field="property.salesperson_id" />
                        </div>
                        <div>
                            <strong>
                                <t t-esc="_t('Expected Price:')" />
                            </strong>
                            <span t-field="property.expected_price" />
                        </div>
                        <div>
                            <strong>
                                <t t-esc="_t('Status:')" />
                            </strong>
                            <span t-field="property.state" />
                        </div>
                        <t t-if="property.state == 'sold'">
                            <p>
                                <t t-esc="_t('Invoice has already been created.')" />
                            </p>
                        </t>
                        <t t-call="estate.report_property_offers_table" />
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_user_properties_document">
        <t t-foreach="docs" t-as="user">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="user.name" />
                        </h2>
                        <t t-if="user.property_ids">
                            <t t-foreach="user.property_ids" t-as="property">
                                <h3>
                                    <span t-field="property.name" />
                                </h3>
                                <div>
                                    <strong>
                                        <t t-esc="_t('Expected Price:')" />
                                    </strong>
                                    <span t-field="property.expected_price" />
                                </div>
                                <div>
                                    <strong>
                                        <t t-esc="_t('Status:')" />
                                    </strong>
                                    <span t-field="property.state" />
                                </div>
                                <t t-if="property.state == 'sold'">
                                    <p>
                                        <t t-esc="_t('Invoice has already been created.')" />
                                    </p>
                                </t>
                                <t t-call="estate.report_property_offers_table" />
                            </t>
                        </t>
                        <t t-else="">
                            <p>
                                <t t-esc="_t('This salesperson has no properties.')" />
                            </p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
