<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_property_offers_table">
        <t t-if="property.offer_ids">
            <table class="table">
                <thead>
                    <tr>
                        <th><t t-esc="_t('Partner')"/></th>
                        <th><t t-esc="_t('Price')"/></th>
                        <th><t t-esc="_t('Status')"/></th>
                        <th><t t-esc="_t('Deadline')"/></th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="property.offer_ids" t-as="offer">
                        <td>
                            <span t-field="offer.partner_id"/>
                        </td>
                        <td>
                            <span t-field="offer.price"/>
                        </td>
                        <td>
                            <span t-field="offer.status"/>
                        </td>
                        <td>
                            <span t-field="offer.date_deadline"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
        <t t-else="">
            <p><t t-esc="_t('There are no offers for this property yet.')"/></p>
        </t>
    </template>
</odoo>
