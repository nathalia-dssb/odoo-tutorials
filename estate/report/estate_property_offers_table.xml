<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_property_offers_table">
        <t t-if="property.offer_ids">
            <table class="table">
                <thead>
                    <tr>
                        <th>Partner</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Deadline</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="property.offer_ids" t-as="offer">
                        <td>
                            <span t-field="offer.partner_id"/>
                        </td>
                        <td>
                            <span t-field="offer.price"/>
                        </td>
                        <td>
                            <span t-field="offer.status"/>
                        </td>
                        <td>
                            <span t-field="offer.date_deadline"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
        <t t-else="">
            <p>There are no offers for this property yet.</p>
        </t>
    </template>
</odoo>
